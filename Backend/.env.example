# Backend environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env file.

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# --- AI provider: set ONE of the two ---

# Groq (used whenever GROQ_API_KEY is set) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional, defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (used only when GROQ_API_KEY is not set) — https://aistudio.google.com/apikey
# GOOGLE_GENAI_API_KEY=your_gemini_api_key
# Optional, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Deployment (optional locally) ---

# Set to "production" on your host so the auth cookie is HTTPS-only
NODE_ENV=development

# Frontend origin(s) allowed to call the API directly, comma-separated.
# Not needed when the frontend proxies /api (the Vercel setup in the README).
CLIENT_URL=http://localhost:5173

# "lax" (default) when the frontend proxies /api; "none" only if the frontend
# calls this API from a different site.
COOKIE_SAMESITE=lax

# --- Payments: Razorpay subscriptions (optional) ---
# Without the keys the paid plans show as not purchasable and the billing
# endpoints answer 503 BILLING_DISABLED. Keys: Razorpay Dashboard → API Keys
# (use rzp_test_... keys until you go live).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret

# Dashboard → Webhooks: URL https://<your-backend>/api/billing/webhook, a
# secret of your choice (put it here), and the subscription.* and
# payment.failed events.
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Plan ids (plan_...). Create them with: node scripts/createRazorpayPlans.js
# RAZORPAY_PLAN_PRO=plan_xxxxxxxxxxxx
# RAZORPAY_PLAN_PREMIUM=plan_xxxxxxxxxxxx

# --- Limits (optional) ---

# Free plan limits. Paid plan (Pro / Premium) limits live in src/config/plans.js.
# AI reports a Free user can generate per UTC day (default 2) and per month (default 5)
# AI_DAILY_LIMIT=2
# AI_MONTHLY_LIMIT=5

# Practice answer reviews a Free user can get per UTC day (default 10) and per month (default 30)
# AI_DAILY_REVIEW_LIMIT=10
# AI_MONTHLY_REVIEW_LIMIT=30

# Site-wide caps on AI provider usage, across all users and retries included,
# so the site stays under the provider's own rate limits. Groq limits requests
# AND tokens; for openai/gpt-oss-120b its docs list 30 requests/min, 1K/day,
# 8K tokens/min and 200K tokens/day. Set these a little below your plan's
# numbers (https://console.groq.com/settings/limits). Over a cap, users get
# "busy, try again" (503) and their own allowance is refunded.
# AI_GLOBAL_PER_MINUTE=25
# AI_GLOBAL_PER_DAY=900
# AI_GLOBAL_TOKENS_PER_MINUTE=7000
# AI_GLOBAL_TOKENS_PER_DAY=180000

# Proxies in front of the API, so per-IP limits see the real client.
# 2 = Vercel's /api rewrite + Render's load balancer (default). Use 0 locally
# when nothing sits in front of the server.
# TRUST_PROXY_HOPS=2

# Most hosts (Render, Railway) set PORT for you
# PORT=3000
