# Backend environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env file.

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# --- AI provider: set ONE of the two ---

# Groq (used whenever GROQ_API_KEY is set) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
# Optional, defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (used only when GROQ_API_KEY is not set) — https://aistudio.google.com/apikey
# GOOGLE_GENAI_API_KEY=your_gemini_api_key
# Optional, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- Deployment (optional locally) ---

# Set to "production" on your host so the auth cookie is HTTPS-only
NODE_ENV=development

# Frontend origin(s) allowed to call the API directly, comma-separated.
# Not needed when the frontend proxies /api (the Vercel setup in the README).
CLIENT_URL=http://localhost:5173

# "lax" (default) when the frontend proxies /api; "none" only if the frontend
# calls this API from a different site.
COOKIE_SAMESITE=lax

# --- Limits (optional) ---

# AI reports each user can generate per UTC day (default 10)
# AI_DAILY_LIMIT=10

# Practice answer reviews each user can get per UTC day (default 30)
# AI_DAILY_REVIEW_LIMIT=30

# Proxies in front of the API, so per-IP limits see the real client.
# 2 = Vercel's /api rewrite + Render's load balancer (default). Use 0 locally
# when nothing sits in front of the server.
# TRUST_PROXY_HOPS=2

# Most hosts (Render, Railway) set PORT for you
# PORT=3000
