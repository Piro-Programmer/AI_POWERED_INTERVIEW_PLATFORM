# Frontend environment variables (optional) — copy to .env.local if needed.

# Leave unset to use same-origin /api, proxied by vite.config.js in development
# and by vercel.json in production (recommended: keeps the auth cookie same-site).
# Set it only to call the backend directly, e.g. https://your-backend.onrender.com
# (then also set CLIENT_URL and COOKIE_SAMESITE=none on the backend).
# VITE_API_URL=
